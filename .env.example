# Required secrets
OPENROUTER_API_KEY=
# Generate with: openssl rand -hex 32
GRADER_API_TOKEN=

# Optional LDR adapter. Disabled by default: the core service works through
# POST /v1/papers without any LDR installation.
# LDR_USER=
# LDR_PASS=
# GRADER_LDR_ENABLED=false
# GRADER_LDR_BASE=http://ldr-host:5000

# Optional overrides — Compose already has sensible defaults for these.
# GRADER_IMAGE=grader:0.2.9
# GRADER_BIND_IP=0.0.0.0
# GRADER_PUBLISH_PORT=9131
# GRADER_HOST=0.0.0.0
# GRADER_PORT=9131
# GRADER_STATE_DIR=./state
# GRADER_CONFIG_FILE=./config.json
# GRADER_WORKER_THREADS=2
# GRADER_JUDGE_ATTEMPTS=4
# GRADER_UID=1000
# GRADER_GID=1000
# GRADER_RUBRIC_OVERLAY=/config/rubrics
# GRADER_QUERIES_FILE=/config/rubrics/queries.json
# GRADER_OPENROUTER_BASE=https://openrouter.ai/api/v1
# GRADER_PRIMARY_MODEL=deepseek/deepseek-v4-flash
# GRADER_SECONDARY_MODEL=z-ai/glm-5.3-flash
# GRADER_TIEBREAKER_MODEL=deepseek/deepseek-v4-pro
